diff --git a/wayland.c b/wayland.c
index 15185ff..385aeb6 100644
--- a/wayland.c
+++ b/wayland.c
@@ -140,6 +140,7 @@ struct wayland {
     enum fcft_subpixel subpixel;
     bool font_is_sized_by_dpi;
     bool hide_when_prompt_empty;
+    bool list_hidden;
 
     enum { KEEP_RUNNING, EXIT_UPDATE_CACHE, EXIT} status;
     int exit_code;
@@ -2059,15 +2060,33 @@ wayl_refresh(struct wayland *wayl)
     /* Window content */
     matches_lock(wayl->matches);
     render_prompt(wayl->render, buf, wayl->prompt, wayl->matches);
-    if (wayl->hide_when_prompt_empty) {
-        if (prompt_text(wayl->prompt)[0] != '\0') {
-            wayl->hide_when_prompt_empty = false;
-        } else {
-            goto skip_list;
-        }
-    }
-    render_match_list(wayl->render, buf, wayl->prompt, wayl->matches);
-skip_list:
+    const bool hide_list = wayl->hide_when_prompt_empty &&
+        prompt_text(wayl->prompt)[0] == '\0';
+    bool skip_list = hide_list;
+    if (hide_list != wayl->list_hidden) {
+        /* linux-setup pill mode: grow/shrink the window with the list.
+         * The list is (re)painted by the fresh frame the configure event
+         * triggers: painting it here would render full-size rows into the
+         * old-size buffer while render workers may still be active. */
+        wayl->list_hidden = hide_list;
+        render_set_visible_lines(
+            wayl->render, hide_list ? 0 : wayl->conf->lines);
+
+        int new_width, new_height;
+        render_set_font_and_update_sizes(
+            wayl->render, NULL, NULL, wayl->scale, wayl->dpi,
+            wayl->font_is_sized_by_dpi, &new_width, &new_height);
+        wayl->width = new_width;
+        wayl->height = new_height;
+        zwlr_layer_surface_v1_set_size(
+            wayl->layer_surface,
+            roundf(wayl->width / wayl->scale),
+            roundf(wayl->height / wayl->scale));
+        wl_surface_commit(wayl->surface);
+        skip_list = true;
+    }
+    if (!skip_list)
+        render_match_list(wayl->render, buf, wayl->prompt, wayl->matches);
     matches_unlock(wayl->matches);
 
 #if defined(FUZZEL_ENABLE_CAIRO)
@@ -2296,6 +2315,14 @@ wayl_init(const struct config *conf, struct fdm *fdm,
         },
     };
 
+    /* linux-setup pill mode: start at the right size so the first
+     * frame never flashes the full-height box (or a clipped list when
+     * launched with --search text). */
+    wayl->list_hidden = conf->hide_when_prompt_empty &&
+        prompt_text(prompt)[0] == '\0';
+    render_set_visible_lines(
+        render, wayl->list_hidden ? 0 : conf->lines);
+
     parse_font_spec(conf->font, &wayl->font_count, &wayl->fonts);
 
     wayl->display = wl_display_connect(NULL);
