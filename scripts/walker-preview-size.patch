+    // ubuntu-i3-setup: inline thumbnails for copied images, so the clipboard
+    // popup needs no side preview panel (fixed size). Text entries keep the
+    // row imageless.
+    fn image_transformer(&self, b: &Builder, _: &ListItem, item: &Item) {
+        let Some(image) = b.object::<Image>("ItemImage") else {
+            return;
+        };
+
+        if item.preview_type != "file" || item.preview.is_empty() {
+            image.set_visible(false);
+            return;
+        }
+
+        let path = item.preview.clone();
+        if !Path::new(&path).exists() {
+            image.set_visible(false);
+            return;
+        }
+
+        image.set_visible(true);
+        glib::spawn_future_local(async move {
+            let Ok((bytes, _)) = gio::File::for_path(&path).load_bytes_future().await
+            else {
+                return;
+            };
+            let stream = gio::MemoryInputStream::from_bytes(&bytes);
+            let cancellable = gio::Cancellable::new();
+            let Ok(pixbuf) = gdk_pixbuf::Pixbuf::from_stream(&stream, Some(&cancellable))
+            else {
+                return;
+            };
+            let (width, height) = (pixbuf.width(), pixbuf.height());
+            let thumb = if width > 128 || height > 128 {
+                let ratio = (128.0 / width as f64).min(128.0 / height as f64);
+                pixbuf.scale_simple(
+                    (width as f64 * ratio) as i32,
+                    (height as f64 * ratio) as i32,
+                    gdk_pixbuf::InterpType::Bilinear,
+                )
+            } else {
+                Some(pixbuf)
+            };
+            if let Some(pixbuf) = thumb {
+                image.set_paintable(Some(&gdk::Texture::for_pixbuf(&pixbuf)));
+            }
+        });
+    }
