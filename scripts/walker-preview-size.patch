+/// Slide the preview panel shut (window follows smoothly). The outer box
+/// stays visible but collapses to zero width; it is replaced on next open.
+pub fn preview_hide() {
+    ACTIVE_REVEALER.with(|active| {
+        if let Some(revealer) = active.borrow().as_ref() {
+            revealer.set_reveal_child(false);
+        }
+    });
+}
