# Optional first-run secrets — NEVER commit this file (see .gitignore).
# cp env.example ~/.config/linux-setup/env && chmod 600 ~/.config/linux-setup/env
#
# OpenWeatherMap (polybar weather module). Get a free key at
# https://openweathermap.org/api then set:
# OPENWEATHER_API_KEY=your_key_here
# City id (default 6077243 = Montreal) or city name ("Montreal,CA"):
# OPENWEATHER_CITY=6077243
# OPENWEATHER_UNITS=metric
