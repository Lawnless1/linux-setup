# swaylock config — linux-setup (niri session).
# Screen locker behind Super+Alt+L, the fuzzel power menu, and swayidle.
# Colors follow the Noctalia NavyGlass palette (config/noctalia/palettes).
# Deployed to ~/.config/swaylock/config.
image=~/Pictures/wallpaper/sunset-peaks.jpg
scaling=fill
color=010B17
font=Inter Nerd Font
font-size=18
# A faint glass ring at rest marks where input goes; Enter on an empty
# field is ignored instead of counting as a wrong password.
indicator-idle-visible
indicator-radius=72
indicator-thickness=5
ignore-empty-password
show-failed-attempts
indicator-caps-lock
inside-color=0B152699
inside-clear-color=0B152699
inside-ver-color=0B1526cc
inside-wrong-color=2a0a14cc
inside-caps-lock-color=0B152699
ring-color=f3edf733
ring-clear-color=a9aefe
ring-ver-color=9BFECE
ring-wrong-color=FD4663
ring-caps-lock-color=fff59b
key-hl-color=9BFECE
bs-hl-color=FD4663
caps-lock-key-hl-color=fff59b
caps-lock-bs-hl-color=FD4663
text-color=f3edf7
text-clear-color=a9aefe
text-ver-color=9BFECE
text-wrong-color=FD4663
text-caps-lock-color=fff59b
line-uses-inside
separator-color=00000000
layout-bg-color=0B152699
layout-border-color=00000000
layout-text-color=f3edf7
