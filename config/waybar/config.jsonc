// Waybar config — ubuntu-i3-setup (niri session).
// Minimal 3-pill bar (see style.css): left = workspaces, center = clock,
// right = essential status (network, sound, battery, powermenu).
// CPU/memory/weather/bluetooth/tray dropped from the bar (kept in style.css
// selectors as no-ops in case a module is re-added later).
//
// NOTE: Ubuntu 24.04 ships waybar 0.9.24, which has no `niri/workspaces`
// module, so workspaces are drawn by custom/niri-workspaces polling
// `niri msg`. After upgrading waybar (>= 0.12), replace that module with:
//   "niri/workspaces": { "format": "{value}" }
// and drop custom/niri-workspaces.
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 0,
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 6,

    "modules-left": ["custom/niri-workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/status"],

    "custom/niri-workspaces": {
        "exec": "$HOME/.config/waybar/scripts/niri-workspaces.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": true
    },
    "clock": {
        "format": " {:%d - %I:%M %p}",
        "format-alt": "{:%A, %d %b %Y, %H:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click-right": "mode"
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": ["network", "pulseaudio", "battery", "custom/powermenu"]
    },
    "network": {
        "interval": 5,
        "format-wifi": " {essid} {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-linked": "{ifname} (no IP)",
        "format-disconnected": "󰖪 offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
    },
    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "custom/powermenu": {
        "format": "",
        "tooltip": "Power menu (Ctrl+Alt+Delete)",
        "on-click": "$HOME/.config/niri/scripts/powermenu-fuzzel.sh"
    }
}
