// niri config — linux-setup (Wayland session).
// Keybindings are i3-style (Super = Mod, j/k/l/; for focus); the full table
// lives in README.md ("Keybindings").

// Wayland-first env so apps don't fall back to Xwayland unnecessarily.
environment {
    GDK_BACKEND "wayland,x11"
    QT_QPA_PLATFORM "wayland;xcb"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    SDL_VIDEODRIVER "wayland"
    // One cursor theme everywhere: Xwayland/Qt/Electron clients that ignore
    // the compositor theme read these (real Windows 10 set, size 32).
    XCURSOR_THEME "wincursors"
    XCURSOR_SIZE "32"
}

input {
    keyboard {
        xkb {
            // Empty: niri fetches the layout from org.freedesktop.locale1.
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.3
    }

    mouse {
        accel-speed 0.5
    }
}

layout {
    gaps 10

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Thin pastel ring instead of borders.
    focus-ring {
        width 2
        active-color "#9BF6FF"
        inactive-color "#000000"
    }

    border {
        off
    }
}

// Pre-create workspaces 1..10 so Mod+1..0 always has a stable target.
workspace "1" {}
workspace "2" {}
workspace "3" {}
workspace "4" {}
workspace "5" {}
workspace "6" {}
workspace "7" {}
workspace "8" {}
workspace "9" {}
workspace "10" {}

spawn-at-startup "noctalia"
// Notifications come from the Noctalia daemon ([notification] enable_daemon
// in config/noctalia/config.toml) — never spawn a second notification
// daemon here or the two fight over org.freedesktop.Notifications.
// Noctalia is also the polkit agent ([shell] polkit_agent).
// Spotlight backend (apps + indexed files) and instant launcher service.
spawn-at-startup "elephant"
spawn-sh-at-startup "exec walker --gapplication-service"
spawn-sh-at-startup "swaybg -i \"$HOME/Pictures/wallpaper/dark.jpg\" -m fill"
// Idle: lock after 5 min, lock before suspend.
spawn-sh-at-startup "exec swayidle -w timeout 300 'swaylock -f' before-sleep 'swaylock -f'"

// Overlay stays enabled on first login so the binds are discoverable.
hotkey-overlay {
}

prefer-no-csd

// Matches XCURSOR_* above (scripts/install-windows-cursors.sh).
cursor {
    xcursor-theme "wincursors"
    xcursor-size 32
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Rounded corners on every window (matches the floating bar pills).
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Focus transparency: focused pane fully opaque, unfocused panes clearly
// translucent (0.90 — raise/lower to taste, 1.0 = opaque) with
// the background behind them blurred (strength from the `blur` block below).
window-rule {
    match is-focused=true
    opacity 1.0
}

window-rule {
    match is-focused=false
    opacity 0.90

    background-effect {
        blur true
    }
}

// Background blur (niri >= 26.04, PR #3483). Global tuning for all blur,
// whether requested by the client (ext-background-effect) or forced below.
// offset is the blur radius — raised so the frosted unfocused panes (and the
// fuzzel/noctalia surfaces) read as clearly blurred, not just softened.
blur {
    passes 3
    offset 6.0
    noise 0.02
    saturation 1.5
}

// Top/overlay layers sit above windows: use true content blur, not the
// cheap wallpaper-only xray default (xray stays on for bottom/background).
layer-rule {
    match layer="top"
    match layer="overlay"

    background-effect {
        xray false
    }
}

// Noctalia bar: shaped per-pill blur is published by the client itself
// (ext-background-effect), so no forced surface blur here — that would
// smear the whole bar width. xray off gives true content blur; the generic
// top/overlay rule above already covers it, this rule pins the documented
// namespace pattern explicitly.
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"

    background-effect {
        xray false
    }
}

// Fuzzel omnibar + dmenu menus (launcher, power, wifi, files): same
// treatment. Fuzzel colors stay semi-transparent (config/fuzzel/*.ini).
// (Walker needs no forced rule: it requests shaped blur itself via
// ext_background_effect_blur in config/walker/config.toml, which follows
// its rounded pill exactly instead of blurring the whole surface rect.)
layer-rule {
    match namespace="^launcher$"

    geometry-corner-radius 16

    background-effect {
        blur true
    }
}

binds {
    // ---- terminal / launcher ----
    // foot runs `tmux new-session`: every window gets its own fresh session
    // (separate sessions, per user choice 2026-09-25 — not one shared session).
    Mod+Return hotkey-overlay-title="Terminal: foot + tmux" { spawn "foot" "tmux" "new-session"; }
    // App grid.
    Mod+D hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }
    // Unified Spotlight search: walker (apps + files, real icons). Mod+D
    // keeps the fuzzel grid, Mod+F the fuzzel text search as fallback.
    // Fixed 770x480 box (see pill/layout.xml: BoxWrapper requests pin it,
    // list scrolls past 330px). Stable regardless of result count; empty
    // space when few results instead of shrinking.
    // -N hides the bottom action/keybind hint bar.
    Mod+Space hotkey-overlay-title="Search: walker" { spawn "walker" "-N"; }
    // Spotlight-style file search (fd + fuzzel dmenu).
    Mod+F hotkey-overlay-title="File search: fuzzel" { spawn-sh "~/.config/niri/scripts/file-search-fuzzel.sh"; }

    // ---- kill window ----
    Ctrl+Delete { close-window; }

    // ---- focus (j/k/l/; + arrows) ----
    // Mod+Up is fullscreen (below), NOT focus-up, so Mod+L is the only
    // focus-up bind.
    Mod+J { focus-column-left; }
    Mod+K { focus-window-down; }
    Mod+L { focus-window-up; }
    Mod+Semicolon { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Right { focus-column-right; }

    // ---- move windows (Shift + j/k/l/; + arrows) ----
    // Left/right use the `-or-to-monitor-` variants so Win+Shift+Left/Right
    // reorders within the screen, then jumps to the adjacent screen at the
    // edge (Windows-style move-window-across-monitors, 3-screen setup).
    Mod+Shift+J { move-column-left-or-to-monitor-left; }
    Mod+Shift+K { move-window-down; }
    Mod+Shift+L { move-window-up; }
    Mod+Shift+Semicolon { move-column-right-or-to-monitor-right; }
    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }

    // ---- join/split columns ----
    // Only the left direction is bound: Mod+V is the Windows-style
    // clipboard history (below).
    Mod+H hotkey-overlay-title="Join/split column to the left" { consume-or-expel-window-left; }

    // ---- clipboard history (Windows Win+V analog) ----
    // Walker + elephant clipboard provider (text + images, pin/search;
    // requires wl-clipboard + imagemagick, provider built by
    // scripts/build-walker.sh). Minimal clipboard theme (-t), no
    // quick-activation chips (-H), no keybind hint bar (-N).
    // Selecting an entry copies it AND pastes straight into the
    // refocused window (clipboard-pick-paste.sh); cancelling pastes nothing.
    Mod+V hotkey-overlay-title="Clipboard history: walker" { spawn-sh "~/.config/niri/scripts/clipboard-pick-paste.sh"; }

    // ---- fullscreen ----
    // NOTE: Ctrl+F intentionally unbound — it belongs to apps (find).
    Mod+Up { fullscreen-window; }

    // ---- column layouts: tabbed, maximized, centered ----
    Mod+S { toggle-column-tabbed-display; }
    Mod+W { maximize-column; }
    Mod+E { center-column; }

    // ---- floating toggle ----
    Mod+Shift+Space { toggle-window-floating; }

    // ---- workspaces: Mod+N focus, Mod+Shift+N move ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // Mod+Ctrl+Shift+N duplicates Mod+Shift+N for muscle memory.
    Mod+Ctrl+Shift+1 { move-window-to-workspace 1; }
    Mod+Ctrl+Shift+2 { move-window-to-workspace 2; }
    Mod+Ctrl+Shift+3 { move-window-to-workspace 3; }
    Mod+Ctrl+Shift+4 { move-window-to-workspace 4; }
    Mod+Ctrl+Shift+5 { move-window-to-workspace 5; }
    Mod+Ctrl+Shift+6 { move-window-to-workspace 6; }

    // ---- exit (niri asks for confirmation; config hot-reloads on save) ----
    Mod+Shift+E { quit; }

    // ---- resize: Mod+R cycles preset widths, Minus/Equal fine-tune ----
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ---- screenshot (region via slurp + grim) ----
    Mod+Shift+S { spawn-sh "~/.config/niri/scripts/screenshot.sh"; }

    // ---- power menu ----
    Ctrl+Alt+Delete { spawn-sh "~/.config/niri/scripts/powermenu-fuzzel.sh"; }

    // ---- volume (pactl via pipewire-pulse) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ +5%"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ -5%"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "pactl set-sink-mute @DEFAULT_SINK@ toggle"; }

    // ---- brightness ----
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // ---- niri-native extras ----
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }
    Mod+Shift+P { power-off-monitors; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
