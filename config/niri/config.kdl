// niri config — ubuntu-i3-setup (Wayland session, side-by-side with i3).
// Mirrors ~/.config/i3/config keybindings as closely as niri's scrollable-tiling
// model allows. i3 concepts with no niri equivalent are noted at the bind site.
// Full mapping rationale: README.md ("Niri session" section).
//
// Notation: "Mod" below IS Super (Mod4), same as $mod in the i3 config.

// Wayland-first env so apps don't fall back to Xwayland unnecessarily.
environment {
    GDK_BACKEND "wayland,x11"
    QT_QPA_PLATFORM "wayland;xcb"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    SDL_VIDEODRIVER "wayland"
    // One cursor theme everywhere: Xwayland/Qt/Electron clients that ignore
    // the compositor theme read these (real Windows 10 set, size 32).
    XCURSOR_THEME "wincursors"
    XCURSOR_SIZE "32"
}

input {
    keyboard {
        xkb {
            // Empty: niri fetches layout from org.freedesktop.locale1
            // (same layout you use on X11 / GNOME Wayland).
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // Keep in sync with POINTER_TOUCHPAD_SPEED in config/input/pointer.sh (0.3).
        // (That script is X11/xinput only; niri reads this value instead.)
        accel-speed 0.3
    }

    mouse {
        // Keep in sync with POINTER_MOUSE_SPEED in config/input/pointer.sh (0.5).
        accel-speed 0.5
    }
}

layout {
    // i3 parity: `gaps inner 10`.
    gaps 10

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // i3 parity: thin pastel border (i3 `client.focused` border was #9BF6FF).
    focus-ring {
        width 2
        active-color "#9BF6FF"
        inactive-color "#000000"
    }

    border {
        off
    }
}

// Pre-create workspaces 1..10 so $mod+1..0 always has a stable target,
// like i3's `set $ws1..$ws10` + `workspace number` binds.
workspace "1" {}
workspace "2" {}
workspace "3" {}
workspace "4" {}
workspace "5" {}
workspace "6" {}
workspace "7" {}
workspace "8" {}
workspace "9" {}
workspace "10" {}

spawn-at-startup "noctalia"
spawn-at-startup "dunst"
// Spotlight backend (apps + indexed files) and instant launcher service.
spawn-at-startup "elephant"
spawn-sh-at-startup "exec walker --gapplication-service"
spawn-sh-at-startup "swaybg -i \"$HOME/Pictures/wallpaper/dark.jpg\" -m fill"
spawn-sh-at-startup "[ -x /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 ] && exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1"
// Idle: lock after 5 min, lock before suspend.
spawn-sh-at-startup "exec swayidle -w timeout 300 'swaylock -f' before-sleep 'swaylock -f'"

hotkey-overlay {
    // Keep the overlay on first login so translated i3 binds are discoverable.
}

prefer-no-csd

// i3 parity: ~/.Xresources sets `Xcursor.theme: wincursors` (size 32).
cursor {
    xcursor-theme "wincursors"
    xcursor-size 32
}

// Same naming as the i3 setup: ~/Pictures/Screenshots/.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Rounded corners on every window (matches the floating waybar pills).
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Focus transparency: focused pane fully opaque, unfocused panes very
// slightly translucent (0.95 — raise/lower to taste, 1.0 = opaque) with
// the background behind them blurred (strength from the `blur` block below).
window-rule {
    match is-focused=true
    opacity 1.0
}

window-rule {
    match is-focused=false
    opacity 0.95

    background-effect {
        blur true
    }
}

// Background blur (niri >= 26.04, PR #3483). Global tuning for all blur,
// whether requested by the client (ext-background-effect) or forced below.
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

// Top/overlay layers sit above windows: use true content blur, not the
// cheap wallpaper-only xray default (xray stays on for bottom/background).
layer-rule {
    match layer="top"
    match layer="overlay"

    background-effect {
        xray false
    }
}

// Noctalia bar: shaped per-pill blur is published by the client itself
// (ext-background-effect), so no forced surface blur here — that would
// smear the whole bar width (the old waybar problem). xray off gives true
// content blur; the generic top/overlay rule above already covers it, this
// rule pins the documented namespace pattern explicitly.
// (Waybar is retired: config/waybar stays dormant for easy revert.)
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"

    background-effect {
        xray false
    }
}

// Fuzzel omnibar + dmenu menus (launcher, power, wifi, files): same
// treatment. Fuzzel colors stay semi-transparent (config/fuzzel/*.ini).
// (Walker needs no forced rule: it requests shaped blur itself via
// ext_background_effect_blur in config/walker/config.toml, which follows
// its rounded pill exactly instead of blurring the whole surface rect.)
layer-rule {
    match namespace="^launcher$"

    geometry-corner-radius 16

    background-effect {
        blur true
    }
}

// Dunst banners: blur behind notifications. Needs a semi-transparent
// background in config/dunst/dunstrc to be visible.
layer-rule {
    match namespace="^notifications$"

    geometry-corner-radius 12

    background-effect {
        blur true
    }
}

binds {
    // ---- terminal / launcher (i3: $mod+Return, $mod+d, $mod+space) ----
    // foot runs `tmux new-session`: every window gets its own fresh session
    // (separate sessions, per user choice 2026-09-25 — not one shared session).
    Mod+Return hotkey-overlay-title="Terminal: foot + tmux" { spawn "foot" "tmux" "new-session"; }
    // i3 `$mod+d` ran dmenu; dmenu is X11-only so fuzzel takes the launcher bind.
    Mod+D hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }
    // i3 `$mod+space` ran `rofi -show drun`; unified Spotlight search instead:
    // walker (apps + files, real icons). $mod+d keeps the fuzzel grid,
    // $mod+f keeps the fuzzel text search as fallback.
    // Fixed 770x480 box (see pill/layout.xml: BoxWrapper requests pin it,
    // list scrolls past 330px). Stable regardless of result count; empty
    // space when few results instead of shrinking.
    // -N hides the bottom action/keybind hint bar.
    Mod+Space hotkey-overlay-title="Search: walker" { spawn "walker" "-N"; }
    // No i3 counterpart: Spotlight-style file search (fd + fuzzel dmenu).
    Mod+F hotkey-overlay-title="File search: fuzzel" { spawn-sh "~/.config/niri/scripts/file-search-fuzzel.sh"; }

    // ---- kill window (i3: Ctrl+Delete) ----
    Ctrl+Delete { close-window; }

    // ---- focus (i3: $mod+j/k/l/; + arrows) ----
    // NOTE: i3 binds $mod+Up to fullscreen (below), NOT focus-up, so Mod+L is
    // the only focus-up bind here too. This is deliberate i3 parity.
    Mod+J { focus-column-left; }
    Mod+K { focus-window-down; }
    Mod+L { focus-window-up; }
    Mod+Semicolon { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Right { focus-column-right; }

    // ---- move windows (i3: $mod+Shift+j/k/l/; + arrows) ----
    // Left/right use the `-or-to-monitor-` variants so Win+Shift+Left/Right
    // reorders within the screen, then jumps to the adjacent screen at the
    // edge (Windows-style move-window-across-monitors, 3-screen setup).
    Mod+Shift+J { move-column-left-or-to-monitor-left; }
    Mod+Shift+K { move-window-down; }
    Mod+Shift+L { move-window-up; }
    Mod+Shift+Semicolon { move-column-right-or-to-monitor-right; }
    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }

    // ---- join/split columns (i3: $mod+h split h, $mod+v split v) ----
    // niri has no h/v splits; consuming/expelling a column is the equivalent
    // of joining/splitting the horizontal tiling. Only the left direction
    // is bound: Mod+V is the Windows-style clipboard history (below), so
    // the expel-right bind was dropped (per user choice, 2026-09-22).
    Mod+H hotkey-overlay-title="Join/split column to the left" { consume-or-expel-window-left; }

    // ---- clipboard history (Windows Win+V analog; no i3 counterpart) ----
    // Walker + elephant clipboard provider (text + images, pin/search;
    // requires wl-clipboard + imagemagick, provider built by
    // scripts/build-walker.sh). Minimal clipboard theme (-t), no
    // quick-activation chips (-H), no keybind hint bar (-N).
    // Enter copies back to clipboard.
    Mod+V hotkey-overlay-title="Clipboard history: walker" { spawn "walker" "-m" "clipboard" "-t" "clipboard" "-H" "-N"; }

    // ---- fullscreen (i3: $mod+Up, single press) ----
    // NOTE: Ctrl+F intentionally unbound — it belongs to apps (find).
    Mod+Up { fullscreen-window; }

    // ---- layouts (i3: $mod+s stacking, $mod+w tabbed, $mod+e toggle split) ----
    // Approximations: niri's tabbed-column display looks like i3 stacking;
    // maximize-column isolates one window like i3 tabbed focus;
    // center-column is the "re-arrange" toggle for $mod+e.
    Mod+S { toggle-column-tabbed-display; }
    Mod+W { maximize-column; }
    Mod+E { center-column; }

    // ---- floating toggle (i3: $mod+Shift+space) ----
    Mod+Shift+Space { toggle-window-floating; }

    // i3 `$mod+a focus parent`: no niri equivalent (columns have no
    // parent container). Dropped; Mod+J/Semicolon covers column focus.

    // ---- workspaces (i3: $mod+1..0 focus, $mod+Shift+1..0 move) ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // i3 extras ($mod+Ctrl+Shift+1..6 move container): same target, kept for
    // muscle memory.
    Mod+Ctrl+Shift+1 { move-window-to-workspace 1; }
    Mod+Ctrl+Shift+2 { move-window-to-workspace 2; }
    Mod+Ctrl+Shift+3 { move-window-to-workspace 3; }
    Mod+Ctrl+Shift+4 { move-window-to-workspace 4; }
    Mod+Ctrl+Shift+5 { move-window-to-workspace 5; }
    Mod+Ctrl+Shift+6 { move-window-to-workspace 6; }

    // ---- reload / restart / exit ----
    // i3 `$mod+Shift+c reload`: niri hot-reloads this file on save; no bind needed.
    // i3 `$mod+Shift+r restart`: meaningless in niri (session restart = log out/in),
    // so the bind cycles column widths in reverse instead (see resize below).
    // i3 `$mod+Shift+e` exit confirm: niri's quit dialog is the equivalent.
    Mod+Shift+E { quit; }

    // ---- resize (i3: $mod+r resize mode, j/k/l/; + arrows inside) ----
    // niri has no modal resize; $mod+r cycles the preset column widths and
    // Minus/Equal fine-tune width/height directly.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    // i3 scratchpad ($mod+Shift+minus stash, $mod+minus recall) has no niri
    // equivalent, so Minus/Equal are repurposed for sizing (above).

    // ---- screenshot (i3: $mod+Shift+s flameshot; flameshot is X11-broken) ----
    Mod+Shift+S { spawn-sh "~/.config/niri/scripts/screenshot.sh"; }

    // ---- power menu (i3: Ctrl+Mod1+Delete rofi powermenu) ----
    Ctrl+Alt+Delete { spawn-sh "~/.config/niri/scripts/powermenu-fuzzel.sh"; }

    // ---- volume (i3: pactl binds, kept identical — works via pipewire-pulse) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ +5%"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ -5%"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "pactl set-sink-mute @DEFAULT_SINK@ toggle"; }

    // ---- brightness (i3: brightnessctl binds, kept identical) ----
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // ---- niri-native extras (no i3 counterpart; listed in README) ----
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }
    Mod+Shift+P { power-off-monitors; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
