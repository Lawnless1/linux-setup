+void Bar::applyBarCapsuleCompositorBlur(BarInstance& instance) const {
+  LayerSurface* surface = instance.surface.get();
+  const int surfW = static_cast<int>(surface->width());
+  const int surfH = static_cast<int>(surface->height());
+
+  std::vector<InputRect> strips;
+  const std::vector<BarCapsuleRun>* lanes[3] = {
+      &instance.startCapsuleRuns, &instance.centerCapsuleRuns, &instance.endCapsuleRuns};
+  for (const auto* lane : lanes) {
+    for (const auto& run : *lane) {
+      if (run.bg == nullptr || !run.hasPaintedCapsuleBackground) {
+        continue;
+      }
+      float absX = 0.0F;
+      float absY = 0.0F;
+      Node::absolutePosition(run.bg, absX, absY);
+      const RoundedRectStyle& style = run.bg->style();
+      // Same body+inset convention as the bar-background path: tessellateShape
+      // expects the body rect and expands it outward by logicalInset itself.
+      const int insetL = static_cast<int>(std::lround(style.logicalInset.left));
+      const int insetT = static_cast<int>(std::lround(style.logicalInset.top));
+      const int insetR = static_cast<int>(std::lround(style.logicalInset.right));
+      const int insetB = static_cast<int>(std::lround(style.logicalInset.bottom));
+      const int px = static_cast<int>(std::lround(absX));
+      const int py = static_cast<int>(std::lround(absY));
+      const int pw = static_cast<int>(std::lround(std::max(0.0F, run.bg->width())));
+      const int ph = static_cast<int>(std::lround(std::max(0.0F, run.bg->height())));
+      auto runStrips = Surface::tessellateShape(px + insetL, py + insetT, pw - insetL - insetR, ph - insetT - insetB,
+                                                style.corners, style.logicalInset, style.radius);
+      for (const auto& r : runStrips) {
+        const int x0 = std::max(r.x, 0);
+        const int y0 = std::max(r.y, 0);
+        const int x1 = std::min(r.x + r.width, surfW);
+        const int y1 = std::min(r.y + r.height, surfH);
+        if (x1 > x0 && y1 > y0) {
+          strips.push_back(InputRect{x0, y0, x1 - x0, y1 - y0});
+        }
+      }
+    }
+  }
+
+  if (instance.lastBlurRegionValid && strips == instance.lastBlurRects) {
+    return;
+  }
+  instance.lastBlurRects = strips;
+  instance.lastBlurRegionValid = true;
+  if (strips.empty()) {
+    // No visible capsules: no blur at all (deliberately no full-bar fallback).
+    surface->clearBlurRegion();
+    return;
+  }
+  surface->setBlurRegion(strips);
+}
