# ~/.profile: read by login shells and by display managers / greetd before
# niri-session, so PATH set here reaches the whole Wayland session.
# Linked by install.sh only when no ~/.profile exists yet.

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# linux-setup: micromamba + opencode CLIs when present (no hard-coded user)
if [ -d "$HOME/.local/share/mamba/bin" ] ; then
    case ":$PATH:" in
        *":$HOME/.local/share/mamba/bin:"*) ;;
        *) PATH="$PATH:$HOME/.local/share/mamba/bin" ;;
    esac
fi
if [ -d "$HOME/.opencode/bin" ] ; then
    case ":$PATH:" in
        *":$HOME/.opencode/bin:"*) ;;
        *) PATH="$HOME/.opencode/bin:$PATH" ;;
    esac
fi

# linux-setup: GTK_MODULES hygiene — appmenu-gtk-module segfaults
# blueman-manager (global-menu packages re-append it from /etc/profile.d
# every login shell). niri has no global menu, so strip it user-wide.
# Runs here (after /etc/profile.d) so `systemctl --user import-environment`
# in niri-session picks up the cleaned value.
if [ -n "${GTK_MODULES:-}" ]; then
    _ls_gtk=""; _ls_sep=""; _ls_oifs="$IFS"; IFS=":"
    for _ls_m in $GTK_MODULES; do
        case "$_ls_m" in ""|appmenu-gtk-module) continue;; esac
        case ":$_ls_gtk:" in *":$_ls_m:"*) continue;; esac
        _ls_gtk="$_ls_gtk$_ls_sep$_ls_m"; _ls_sep=":"
    done
    IFS="$_ls_oifs"; unset _ls_oifs _ls_m _ls_sep
    GTK_MODULES="$_ls_gtk"; unset _ls_gtk; export GTK_MODULES
fi
