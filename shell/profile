# ~/.profile: executed by the command interpreter for login shells.
# Ubuntu stock file + ubuntu-i3-setup PATH entries (guarded, $HOME-based).
# See https://help.ubuntu.com/community/EnvironmentVariables for stock docs.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# ubuntu-i3-setup: micromamba + opencode CLIs when present (no hard-coded user)
if [ -d "$HOME/.local/share/mamba/bin" ] ; then
    case ":$PATH:" in
        *":$HOME/.local/share/mamba/bin:"*) ;;
        *) PATH="$PATH:$HOME/.local/share/mamba/bin" ;;
    esac
fi
if [ -d "$HOME/.opencode/bin" ] ; then
    case ":$PATH:" in
        *":$HOME/.opencode/bin:"*) ;;
        *) PATH="$HOME/.opencode/bin:$PATH" ;;
    esac
fi

# ubuntu-i3-setup: GTK_MODULES hygiene — appmenu-gtk-module segfaults
# blueman-manager (even a single copy; /etc/profile.d/vala-panel-appmenu.sh
# from removed vala-panel-appmenu-common re-appends it every login shell).
# Neither i3 nor niri uses a global menu, so strip it user-wide.
# Runs here (after /etc/profile.d) so `systemctl --user import-environment`
# in niri-session picks up the cleaned value.
if [ -n "${GTK_MODULES:-}" ]; then
    _i3s_gtk=""; _i3s_sep=""; _i3s_oifs="$IFS"; IFS=":"
    for _i3s_m in $GTK_MODULES; do
        case "$_i3s_m" in ""|appmenu-gtk-module) continue;; esac
        case ":$_i3s_gtk:" in *":$_i3s_m:"*) continue;; esac
        _i3s_gtk="$_i3s_gtk$_i3s_sep$_i3s_m"; _i3s_sep=":"
    done
    IFS="$_i3s_oifs"; unset _i3s_oifs _i3s_m _i3s_sep
    GTK_MODULES="$_i3s_gtk"; unset _i3s_gtk; export GTK_MODULES
fi
UBUNTU_MENUPROXY=0; export UBUNTU_MENUPROXY
